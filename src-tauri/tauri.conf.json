{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CP Studio",
  "version": "0.4.1",
  "identifier": "com.cpstudio.ide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:8443",
    "beforeDevCommand": "npm run dev -- --port 8443",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CP Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "shadow": true,
        "visible": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
